# Python字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 各种缓存目录
.cache/
.pytest_cache/
.mypy_cache/
.hypothesis/

# IDE缓存
.idea/
.vscode/
*.swp
*.swo

# 虚拟环境
venv/
.venv/
ENV/

# 安装包
dist/
build/
*.egg-info/

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.excel_lock

# 敏感文件
cookies.txt

# Claude Code 本机配置（权限规则/启动配置，不上传）
.claude/

# Windows误生成的nul文件
nul

# ================================
# 动态缓存与大文件过滤
# ================================
*.json_lock
.agents/
.codegraph/

# ================================
# 运行期数据（storage 每日重写，体积随期数无限增长，不入库）
# 例外：两个"真相源"与三高录入台账属于不可再生的输入，单独放行
# ================================
data/storage/*
!data/storage/raw/
!data/storage/points/
data/storage/raw/*
data/storage/points/*
!data/storage/raw/daily_points.txt
!data/storage/raw/kl8_history_final.txt
!data/storage/points/tri_high_points.json